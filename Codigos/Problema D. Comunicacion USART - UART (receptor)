; PROBLEMA D - COMUNICACION USART
; ATmega328P - RECEPTOR
;
; PD0 / RX <- TX del primer ATmega
;
; LEDs:
; PB0 -> LED 0
; PB1 -> LED 1
; PB2 -> LED 2
; PB3 -> LED 3
; PB4 -> LED 4
; PB5 -> LED 5
; PC0 -> LED 6
; PC1 -> LED 7
;
; USART: 9600 baudios
; F_CPU: 16 MHz
;

.include "m328Pdef.inc"

;---------------------------------------
; INICIO
;---------------------------------------

.org 0x0000
    rjmp RESET

;---------------------------------------
; RESET
;---------------------------------------

RESET:

    ; Inicializar Stack Pointer
    ldi r16, high(RAMEND)
    out SPH, r16

    ldi r16, low(RAMEND)
    out SPL, r16

    ;-----------------------------------
    ; CONFIGURAR LEDs
    ;-----------------------------------

    ; PB0-PB5 como salidas
    ldi r16, 0b00111111
    out DDRB, r16

    ; PC0-PC1 como salidas
    ldi r16, 0b00000011
    out DDRC, r16

    ; Apagar todos los LEDs
    ldi r16, 0
    out PORTB, r16
    out PORTC, r16

    ;-----------------------------------
    ; CONFIGURAR USART
    ;-----------------------------------

    ; Baud rate = 9600
    ; F_CPU = 16 MHz
    ; UBRR = 103

    ldi r16, high(103)
    sts UBRR0H, r16

    ldi r16, low(103)
    sts UBRR0L, r16

    ; Habilitar receptor
    ldi r16, (1<<RXEN0)
    sts UCSR0B, r16

    ; 8 bits, 1 stop, sin paridad (0b000006 en hex/bin para evitar error de operador en AVRASM2)
    ldi r16, (1<<UCSZ01) + (1<<UCSZ00)
    sts UCSR0C, r16

;---------------------------------------
; PROGRAMA PRINCIPAL
;---------------------------------------

MAIN:

    ; Esperar un dato
    rcall USART_RECIBIR

    ; Apagar todos los LEDs antes de encender el correspondiente
    ldi r16, 0
    out PORTB, r16
    out PORTC, r16

    ;-----------------------------------
    ; Decodificar valor (soporta valor binario 0-7 o ASCII '0'-'7')
    ;-----------------------------------

    ; Si el dato está en ASCII (ej. '0' = 48), le restamos '0'
    cpi r17, '0'
    brlo COMPROBAR_BINARIO
    cpi r17, '7'+1
    brsh COMPROBAR_BINARIO
    subi r17, '0'

COMPROBAR_BINARIO:
    cpi r17, 0
    breq LED0

    cpi r17, 1
    breq LED1

    cpi r17, 2
    breq LED2

    cpi r17, 3
    breq LED3

    cpi r17, 4
    breq LED4

    cpi r17, 5
    breq LED5

    cpi r17, 6
    breq LED6

    cpi r17, 7
    breq LED7

    ; Si llegó un dato fuera de rango (no es 0-7), reiniciar ciclo
    rjmp MAIN

;---------------------------------------
; RUTINAS LEDs
;---------------------------------------

LED0:
    ldi r16, 0b00000001
    out PORTB, r16
    rjmp MAIN

LED1:
    ldi r16, 0b00000010
    out PORTB, r16
    rjmp MAIN

LED2:
    ldi r16, 0b00000100
    out PORTB, r16
    rjmp MAIN

LED3:
    ldi r16, 0b00001000
    out PORTB, r16
    rjmp MAIN

LED4:
    ldi r16, 0b00010000
    out PORTB, r16
    rjmp MAIN

LED5:
    ldi r16, 0b00100000
    out PORTB, r16
    rjmp MAIN

LED6:
    ldi r16, 0b00000001
    out PORTC, r16
    rjmp MAIN

LED7:
    ldi r16, 0b00000010
    out PORTC, r16
    rjmp MAIN

;---------------------------------------
; USART_RECIBIR
;---------------------------------------

USART_RECIBIR:

ESPERAR_DATO:
    lds r18, UCSR0A
    sbrs r18, RXC0
    rjmp ESPERAR_DATO

    lds r17, UDR0
    ret
