;
; ============================================================
; PROBLEMA E - AUTOMATIZACIÓN DE PUERTA DE GARAJE
; ATmega328P
;
; PRACTICA DE LABORATORIO
;
; Los motores se representan mediante LEDs.
;
; ============================================================
;
; ENTRADAS
;
; PC0 -> S1 - Sensor puerta ABIERTA
; PC1 -> S2 - Sensor puerta CERRADA
; PC2 -> Pulsador ABRIR
; PC3 -> Pulsador CERRAR
; PD7 -> S3 - Sensor OBSTACULO
;
; SALIDAS
;
; PB0 -> LED MOTOR ABRIR
; PB1 -> LED MOTOR CERRAR
; PB2 -> LED ALARMA
;
; USART
;
; PD0 -> RX
; PD1 -> TX
; 9600 baudios
;
; INTERRUPCION
;
; PD7 = PCINT23
; Se utiliza PCINT2, NO INT0 ni INT1.
;
; ============================================================


.include "m328pdef.inc"


; ============================================================
; REGISTROS
; ============================================================

.def TEMP    = r16
.def TEMP2   = r17
.def ESTADO  = r18
.def FLAGS   = r19


; ============================================================
; ESTADOS DE LA MAQUINA
; ============================================================

.equ CERRADA   = 0
.equ ABRIENDO  = 1
.equ ABIERTA   = 2
.equ CERRANDO  = 3
.equ SEGURIDAD = 4


; ============================================================
; VECTOR DE RESET
; ============================================================

.org 0x0000
    rjmp INICIO


; ============================================================
; INTERRUPCION PCINT2
;
; PD7 = PCINT23
; ============================================================

.org PCINT2addr
    rjmp ISR_OBSTACULO


; ============================================================
; INICIO
; ============================================================

INICIO:

    ; --------------------------------------------------------
    ; Inicializar Stack
    ; --------------------------------------------------------

    ldi TEMP, high(RAMEND)
    out SPH, TEMP

    ldi TEMP, low(RAMEND)
    out SPL, TEMP


    ; --------------------------------------------------------
    ; CONFIGURAR SALIDAS
    ;
    ; PB0 = LED ABRIR
    ; PB1 = LED CERRAR
    ; PB2 = LED ALARMA
    ; --------------------------------------------------------

    ldi TEMP, (1<<PB0)|(1<<PB1)|(1<<PB2)
    out DDRB, TEMP


    ; Todos los LEDs apagados

    cbi PORTB, PB0
    cbi PORTB, PB1
    cbi PORTB, PB2


    ; --------------------------------------------------------
    ; CONFIGURAR ENTRADAS PC0-PC3
    ;
    ; PC0 = SENSOR ABIERTA
    ; PC1 = SENSOR CERRADA
    ; PC2 = BOTON ABRIR
    ; PC3 = BOTON CERRAR
    ; --------------------------------------------------------

    ldi TEMP, 0x00
    out DDRC, TEMP

    ; Activar pull-up

    ldi TEMP, (1<<PC0)|(1<<PC1)|(1<<PC2)|(1<<PC3)
    out PORTC, TEMP


    ; --------------------------------------------------------
    ; CONFIGURAR PD7
    ;
    ; Sensor de obstaculo
    ; --------------------------------------------------------

    cbi DDRD, PD7

    ; Pull-up interna

    sbi PORTD, PD7


    ; --------------------------------------------------------
    ; USART
    ;
    ; 16 MHz
    ; 9600 baudios
    ; UBRR = 103
    ; --------------------------------------------------------

    ldi TEMP, high(103)
    sts UBRR0H, TEMP

    ldi TEMP, low(103)
    sts UBRR0L, TEMP


    ; Habilitar RX y TX

    ldi TEMP, (1<<RXEN0)|(1<<TXEN0)
    sts UCSR0B, TEMP


    ; 8 bits
    ; 1 stop
    ; sin paridad

    ldi TEMP, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, TEMP


    ; --------------------------------------------------------
    ; INTERRUPCION POR CAMBIO DE PIN
    ;
    ; Habilitar grupo PCINT2
    ; --------------------------------------------------------

    ldi TEMP, (1<<PCIE2)
    sts PCICR, TEMP


    ; Habilitar PCINT23 = PD7

    ldi TEMP, (1<<PCINT23)
    sts PCMSK2, TEMP


    ; --------------------------------------------------------
    ; HABILITAR INTERRUPCIONES GLOBALES
    ; --------------------------------------------------------

    sei


    ; --------------------------------------------------------
    ; DETERMINAR ESTADO INICIAL
    ;
    ; Si S2 = 0 -> puerta cerrada
    ; Si S1 = 0 -> puerta abierta
    ; --------------------------------------------------------

    sbis PINC, PC1
    rjmp INICIO_CERRADA

    sbis PINC, PC0
    rjmp INICIO_ABIERTA


    ; Si ningún sensor está activo,
    ; dejamos la puerta como cerrada.

    ldi ESTADO, CERRADA

    rjmp ESTADO_CERRADA


; ============================================================
; INICIO CERRADA
; ============================================================

INICIO_CERRADA:

    ldi ESTADO, CERRADA

    rjmp ESTADO_CERRADA


; ============================================================
; INICIO ABIERTA
; ============================================================

INICIO_ABIERTA:

    ldi ESTADO, ABIERTA

    rjmp ESTADO_ABIERTA


; ============================================================
; ============================================================
; ESTADO PUERTA CERRADA
; ============================================================
; ============================================================

ESTADO_CERRADA:

    ; Motor y alarma apagados

    rcall APAGAR_SALIDAS


    ; Enviar mensaje

    ldi ZL, low(MSG_CERRADA*2)
    ldi ZH, high(MSG_CERRADA*2)

    rcall USART_MENSAJE


LOOP_CERRADA:

    ; --------------------------------------------------------
    ; ¿PULSADOR ABRIR?
    ;
    ; PC2 = 0 cuando se pulsa
    ; --------------------------------------------------------

    sbis PINC, PC2
    rjmp BOTON_ABRIR


    rjmp LOOP_CERRADA


BOTON_ABRIR:

    ; Antirrebote

    rcall DELAY_20MS


    ; Comprobar nuevamente

    sbic PINC, PC2
    rjmp LOOP_CERRADA


    ; Cambiar a estado ABRIENDO

    ldi ESTADO, ABRIENDO

    rjmp INICIAR_ABRIR


; ============================================================
; ============================================================
; INICIAR APERTURA
; ============================================================
; ============================================================

INICIAR_ABRIR:

    ; --------------------------------------------------------
    ; LED MOTOR ABRIR = ON
    ; LED MOTOR CERRAR = OFF
    ; LED ALARMA = ON
    ; --------------------------------------------------------

    cbi PORTB, PB1

    sbi PORTB, PB0
    sbi PORTB, PB2


    ; Mensaje USART

    ldi ZL, low(MSG_ABRIENDO*2)
    ldi ZH, high(MSG_ABRIENDO*2)

    rcall USART_MENSAJE


    rjmp LOOP_ABRIENDO


; ============================================================
; ============================================================
; ESTADO ABRIENDO
; ============================================================
; ============================================================

LOOP_ABRIENDO:

    ; --------------------------------------------------------
    ; Comprobar si la interrupción detectó obstáculo
    ; --------------------------------------------------------

    cpi ESTADO, SEGURIDAD
    breq ENTRAR_SEGURIDAD


    ; --------------------------------------------------------
    ; ¿PUERTA COMPLETAMENTE ABIERTA?
    ;
    ; PC0 = 0
    ; --------------------------------------------------------

    sbis PINC, PC0
    rjmp PUERTA_ABIERTA


    rjmp LOOP_ABRIENDO


PUERTA_ABIERTA:

    ; Apagar LEDs

    rcall APAGAR_SALIDAS


    ; Cambiar estado

    ldi ESTADO, ABIERTA


    ; Mensaje USART

    ldi ZL, low(MSG_ABIERTA*2)
    ldi ZH, high(MSG_ABIERTA*2)

    rcall USART_MENSAJE


    rjmp LOOP_ABIERTA


; ============================================================
; ============================================================
; ESTADO PUERTA ABIERTA
; ============================================================
; ============================================================

LOOP_ABIERTA:

    ; --------------------------------------------------------
    ; ¿PULSADOR CERRAR?
    ;
    ; PC3 = 0
    ; --------------------------------------------------------

    sbis PINC, PC3
    rjmp BOTON_CERRAR


    rjmp LOOP_ABIERTA


BOTON_CERRAR:

    ; Antirrebote

    rcall DELAY_20MS


    ; Confirmar pulsación

    sbic PINC, PC3
    rjmp LOOP_ABIERTA


    ; Cambiar estado

    ldi ESTADO, CERRANDO

    rjmp INICIAR_CERRAR


; ============================================================
; ============================================================
; INICIAR CIERRE
; ============================================================
; ============================================================

INICIAR_CERRAR:

    ; --------------------------------------------------------
    ; LED MOTOR ABRIR = OFF
    ; LED MOTOR CERRAR = ON
    ; LED ALARMA = ON
    ; --------------------------------------------------------

    cbi PORTB, PB0

    sbi PORTB, PB1
    sbi PORTB, PB2


    ; Mensaje USART

    ldi ZL, low(MSG_CERRANDO*2)
    ldi ZH, high(MSG_CERRANDO*2)

    rcall USART_MENSAJE


    rjmp LOOP_CERRANDO


; ============================================================
; ============================================================
; ESTADO CERRANDO
; ============================================================
; ============================================================

LOOP_CERRANDO:

    ; --------------------------------------------------------
    ; Comprobar si hubo obstáculo
    ; --------------------------------------------------------

    cpi ESTADO, SEGURIDAD
    breq ENTRAR_SEGURIDAD


    ; --------------------------------------------------------
    ; ¿PUERTA COMPLETAMENTE CERRADA?
    ;
    ; PC1 = 0
    ; --------------------------------------------------------

    sbis PINC, PC1
    rjmp PUERTA_CERRADA


    rjmp LOOP_CERRANDO


PUERTA_CERRADA:

    ; Apagar LEDs

    rcall APAGAR_SALIDAS


    ; Cambiar estado

    ldi ESTADO, CERRADA


    ; Mensaje USART

    ldi ZL, low(MSG_CERRADA*2)
    ldi ZH, high(MSG_CERRADA*2)

    rcall USART_MENSAJE


    rjmp LOOP_CERRADA


; ============================================================
; ============================================================
; ESTADO SEGURIDAD
; ============================================================
; ============================================================

ENTRAR_SEGURIDAD:

    ; --------------------------------------------------------
    ; Motor y alarma apagados
    ; --------------------------------------------------------

    rcall APAGAR_SALIDAS


    ; --------------------------------------------------------
    ; Enviar mensajes
    ; --------------------------------------------------------

    ldi ZL, low(MSG_OBSTACULO*2)
    ldi ZH, high(MSG_OBSTACULO*2)

    rcall USART_MENSAJE


    ldi ZL, low(MSG_SEGURIDAD*2)
    ldi ZH, high(MSG_SEGURIDAD*2)

    rcall USART_MENSAJE


    ; --------------------------------------------------------
    ; Quedamos detenidos
    ; hasta volver a pulsar ABRIR o CERRAR.
    ; --------------------------------------------------------

LOOP_SEGURIDAD:

    ; --------------------------------------------------------
    ; BOTON ABRIR
    ; --------------------------------------------------------

    sbis PINC, PC2
    rjmp SEGURIDAD_ABRIR


    ; --------------------------------------------------------
    ; BOTON CERRAR
    ; --------------------------------------------------------

    sbis PINC, PC3
    rjmp SEGURIDAD_CERRAR


    rjmp LOOP_SEGURIDAD


; ============================================================
; DESPUES DE OBSTACULO -> ABRIR
; ============================================================

SEGURIDAD_ABRIR:

    rcall DELAY_20MS

    sbic PINC, PC2
    rjmp LOOP_SEGURIDAD


    ; Si ya está abierta, no mover

    sbis PINC, PC0
    rjmp YA_ESTA_ABIERTA


    ldi ESTADO, ABRIENDO

    rjmp INICIAR_ABRIR


YA_ESTA_ABIERTA:

    ldi ESTADO, ABIERTA

    rjmp ESTADO_ABIERTA


; ============================================================
; DESPUES DE OBSTACULO -> CERRAR
; ============================================================

SEGURIDAD_CERRAR:

    rcall DELAY_20MS

    sbic PINC, PC3
    rjmp LOOP_SEGURIDAD


    ; Si ya está cerrada, no mover

    sbis PINC, PC1
    rjmp YA_ESTA_CERRADA


    ldi ESTADO, CERRANDO

    rjmp INICIAR_CERRAR


YA_ESTA_CERRADA:

    ldi ESTADO, CERRADA

    rjmp ESTADO_CERRADA


; ============================================================
; ESTADO ABIERTA
;
; Esta etiqueta se utiliza para enviar el estado cuando
; se llega inicialmente con S1 activo.
; ============================================================

ESTADO_ABIERTA:

    rcall APAGAR_SALIDAS


    ldi ZL, low(MSG_ABIERTA*2)
    ldi ZH, high(MSG_ABIERTA*2)

    rcall USART_MENSAJE


    rjmp LOOP_ABIERTA


; ============================================================
; ============================================================
; INTERRUPCION SENSOR DE OBSTACULO
; ============================================================
;
; PD7 = PCINT23
;
; La interrupción se produce cuando cambia PD7.
;
; Solo nos interesa cuando PD7 pasa a 0.
;
; Si la puerta está ABRIENDO o CERRANDO:
;
;       MOTOR OFF
;       ALARMA OFF
;       ESTADO = SEGURIDAD
;
; ============================================================

ISR_OBSTACULO:

    ; Guardar registros

    push TEMP

    in TEMP, SREG
    push TEMP


    ; --------------------------------------------------------
    ; Comprobar que PD7 realmente está en 0
    ; --------------------------------------------------------

    sbic PIND, PD7
    rjmp FIN_ISR


    ; --------------------------------------------------------
    ; ¿ESTÁ ABRIENDO?
    ; --------------------------------------------------------

    cpi ESTADO, ABRIENDO
    breq DETENER_POR_OBSTACULO


    ; --------------------------------------------------------
    ; ¿ESTÁ CERRANDO?
    ; --------------------------------------------------------

    cpi ESTADO, CERRANDO
    breq DETENER_POR_OBSTACULO


    ; Si no está en movimiento,
    ; ignorar el obstáculo.

    rjmp FIN_ISR


DETENER_POR_OBSTACULO:

    ; --------------------------------------------------------
    ; APAGAR INMEDIATAMENTE
    ;
    ; PB0 = LED ABRIR
    ; PB1 = LED CERRAR
    ; PB2 = LED ALARMA
    ; --------------------------------------------------------

    cbi PORTB, PB0
    cbi PORTB, PB1
    cbi PORTB, PB2


    ; --------------------------------------------------------
    ; Cambiar máquina de estados
    ; --------------------------------------------------------

    ldi ESTADO, SEGURIDAD


FIN_ISR:

    ; Recuperar registros

    pop TEMP

    out SREG, TEMP

    pop TEMP

    reti


; ============================================================
; ============================================================
; APAGAR SALIDAS
; ============================================================
; ============================================================

APAGAR_SALIDAS:

    cbi PORTB, PB0
    cbi PORTB, PB1
    cbi PORTB, PB2

    ret


; ============================================================
; ============================================================
; USART - ENVIAR MENSAJE
; ============================================================
;
; Z apunta al mensaje almacenado en FLASH.
;
; El mensaje termina en 0.
;
; ============================================================

USART_MENSAJE:

LEER_MENSAJE:

    ; Leer carácter desde FLASH

    lpm TEMP, Z+


    ; ¿Fin del mensaje?

    tst TEMP
    breq FIN_MENSAJE


ESPERAR_USART:

    ; Leer estado USART

    lds TEMP2, UCSR0A


    ; ¿UDRE0 = 1?
    ; Si no, esperar

    sbrs TEMP2, UDRE0
    rjmp ESPERAR_USART


    ; Enviar carácter

    sts UDR0, TEMP


    rjmp LEER_MENSAJE


FIN_MENSAJE:

    ret


; ============================================================
; ============================================================
; DELAY 20 ms
; ============================================================
;
; Antirrebote simple para pulsadores.
;
; ============================================================

DELAY_20MS:

    ldi TEMP, 100


DELAY1:

    ldi TEMP2, 200


DELAY2:

    dec TEMP2

    brne DELAY2

    dec TEMP

    brne DELAY1

    ret


; ============================================================
; ============================================================
; MENSAJES USART
; ============================================================
;
; .align evita problemas de alineación de .db en .cseg.
;
; ============================================================

.align 2

MSG_CERRADA:

    .db "Puerta cerrada", 13, 10, 0


MSG_ABRIENDO:

    .db "Puerta abriendo", 13, 10, 0


MSG_ABIERTA:

    .db "Puerta abierta", 13, 10, 0


MSG_CERRANDO:

    .db "Puerta cerrando", 13, 10, 0


MSG_OBSTACULO:

    .db "Obstaculo detectado", 13, 10, 0


MSG_SEGURIDAD:

    .db "Movimiento detenido por seguridad", 13, 10, 0
