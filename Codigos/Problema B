
;
;============================================================
; PROBLEMA B - DAC R-2R
; ATmega328P
;
; PB0-PB5 -> bits 0-5 del DAC
; PC0-PC1 -> bits 6-7 del DAC
;
; PD0 -> RX USART
; PD1 -> TX USART
;
; USART: 9600 baudios
; F_CPU: 16 MHz
;
; TIMER1:
; Modo CTC
; Prescaler = 64
; OCR1A = 249
; Frecuencia de muestreo = 1000 Hz
;
; USART:
; '1' -> Señal 14
; '2' -> Señal 8
;
;============================================================

.include "m328Pdef.inc"


;============================================================
; REGISTROS
;============================================================

.def TEMP    = r16
.def DATO    = r17
.def INDICE  = r18
.def TEMP2   = r19
.def TEMP3   = r20
.def SENAL   = r21


;============================================================
; RESET
;============================================================

.org 0x0000
    rjmp INICIO


;============================================================
; INICIO
;============================================================

INICIO:

    ;--------------------------------------------------------
    ; CONFIGURAR STACK
    ;--------------------------------------------------------

    ldi TEMP, LOW(RAMEND)
    out SPL, TEMP

    ldi TEMP, HIGH(RAMEND)
    out SPH, TEMP


    ;--------------------------------------------------------
    ; CONFIGURAR DAC
    ;--------------------------------------------------------

    ; PB0-PB5 como salidas
    ldi TEMP, 0b00111111
    out DDRB, TEMP

    ; PC0-PC1 como salidas
    ldi TEMP, 0b00000011
    out DDRC, TEMP

    ; Inicializar DAC en 0
    clr TEMP
    out PORTB, TEMP
    out PORTC, TEMP


    ;--------------------------------------------------------
    ; CONFIGURAR USART
    ;--------------------------------------------------------

    rcall CONFIG_USART


    ;--------------------------------------------------------
    ; CONFIGURAR TIMER1
    ;--------------------------------------------------------

    rcall CONFIG_TIMER


    ;--------------------------------------------------------
    ; SEÑAL INICIAL
    ;--------------------------------------------------------

    ldi SENAL, 1


    ;--------------------------------------------------------
    ; MOSTRAR MENU
    ;--------------------------------------------------------

    rcall MOSTRAR_MENU


;============================================================
; MENU PRINCIPAL
;============================================================

MENU:

    rcall RECIBIR

    ;--------------------------------------------------------
    ; ¿Se recibió '1'?
    ;--------------------------------------------------------

    cpi TEMP, '1'
    breq ELEGIR_14


    ;--------------------------------------------------------
    ; ¿Se recibió '2'?
    ;--------------------------------------------------------

    cpi TEMP, '2'
    breq ELEGIR_8


    ; Si no fue 1 ni 2, volver a esperar
    rjmp MENU


;============================================================
; ELEGIR SEÑAL 14
;============================================================

ELEGIR_14:

    ldi SENAL, 1
    clr INDICE

    ; Mostrar mensaje
    ldi ZL, LOW(MENSAJE14*2)
    ldi ZH, HIGH(MENSAJE14*2)

    rcall ENVIAR_CADENA

    rjmp REPRODUCIR_14


;============================================================
; ELEGIR SEÑAL 8
;============================================================

ELEGIR_8:

    ldi SENAL, 2
    clr INDICE

    ; Mostrar mensaje
    ldi ZL, LOW(MENSAJE8*2)
    ldi ZH, HIGH(MENSAJE8*2)

    rcall ENVIAR_CADENA

    rjmp REPRODUCIR_8


;============================================================
; REPRODUCIR SEÑAL 14
;============================================================

REPRODUCIR_14:

    ;--------------------------------------------------------
    ; Comprobar si se cambió a señal 8
    ;--------------------------------------------------------

    cpi SENAL, 2
    breq REPRODUCIR_8


    ;--------------------------------------------------------
    ; Cargar dirección de LUT14
    ;--------------------------------------------------------

    ldi ZL, LOW(LUT14*2)
    ldi ZH, HIGH(LUT14*2)

    ; Z = LUT14 + INDICE
    add ZL, INDICE

    clr TEMP2
    adc ZH, TEMP2


    ;--------------------------------------------------------
    ; Leer muestra de la LUT
    ;--------------------------------------------------------

    lpm DATO, Z


    ;--------------------------------------------------------
    ; Enviar muestra al DAC
    ;--------------------------------------------------------

    rcall SALIDA_DAC


    ;--------------------------------------------------------
    ; Esperar 1 ms
    ;--------------------------------------------------------

    rcall ESPERAR_TIMER


    ;--------------------------------------------------------
    ; Revisar USART
    ;--------------------------------------------------------

    rcall REVISAR_USART


    ;--------------------------------------------------------
    ; Si cambió a señal 8, saltar
    ;--------------------------------------------------------

    cpi SENAL, 2
    breq REPRODUCIR_8


    ;--------------------------------------------------------
    ; Siguiente muestra
    ;--------------------------------------------------------

    inc INDICE


    ; LUT14 = 150 muestras
    cpi INDICE, 150

    brlo REPRODUCIR_14


    ; Volver al comienzo de la LUT
    clr INDICE

    rjmp REPRODUCIR_14


;============================================================
; REPRODUCIR SEÑAL 8
;============================================================

REPRODUCIR_8:

    ;--------------------------------------------------------
    ; Comprobar si se cambió a señal 14
    ;--------------------------------------------------------

    cpi SENAL, 1
    breq REPRODUCIR_14


    ;--------------------------------------------------------
    ; Cargar dirección de LUT8
    ;--------------------------------------------------------

    ldi ZL, LOW(LUT8*2)
    ldi ZH, HIGH(LUT8*2)

    ; Z = LUT8 + INDICE
    add ZL, INDICE

    clr TEMP2
    adc ZH, TEMP2


    ;--------------------------------------------------------
    ; Leer muestra
    ;--------------------------------------------------------

    lpm DATO, Z


    ;--------------------------------------------------------
    ; Enviar al DAC
    ;--------------------------------------------------------

    rcall SALIDA_DAC


    ;--------------------------------------------------------
    ; Esperar 1 ms
    ;--------------------------------------------------------

    rcall ESPERAR_TIMER


    ;--------------------------------------------------------
    ; Revisar USART
    ;--------------------------------------------------------

    rcall REVISAR_USART


    ;--------------------------------------------------------
    ; Si cambió a señal 14
    ;--------------------------------------------------------

    cpi SENAL, 1
    breq REPRODUCIR_14


    ;--------------------------------------------------------
    ; Siguiente muestra
    ;--------------------------------------------------------

    inc INDICE


    ; LUT8 = 128 muestras
    cpi INDICE, 128

    brlo REPRODUCIR_8


    ; Volver al principio
    clr INDICE

    rjmp REPRODUCIR_8


;============================================================
; SALIDA AL DAC
;============================================================

SALIDA_DAC:

    ;--------------------------------------------------------
    ; PORTB
    ;
    ; PB0 = bit 0
    ; PB1 = bit 1
    ; PB2 = bit 2
    ; PB3 = bit 3
    ; PB4 = bit 4
    ; PB5 = bit 5
    ;--------------------------------------------------------

    mov TEMP2, DATO

    ; Conservar solamente bits 0-5
    andi TEMP2, 0x3F


    ; Leer PORTB
    in TEMP3, PORTB

    ; Conservar PB6 y PB7
    andi TEMP3, 0xC0


    ; Combinar
    or TEMP3, TEMP2

    ; Sacar al puerto
    out PORTB, TEMP3


    ;--------------------------------------------------------
    ; PORTC
    ;
    ; PC0 = bit 6
    ; PC1 = bit 7
    ;--------------------------------------------------------

    mov TEMP2, DATO

    ; Desplazar bits 6-7 hasta bits 0-1

    lsr TEMP2
    lsr TEMP2
    lsr TEMP2
    lsr TEMP2
    lsr TEMP2
    lsr TEMP2


    ; Conservar solamente bits 0-1
    andi TEMP2, 0x03


    ; Leer PORTC
    in TEMP3, PORTC

    ; Conservar PC2-PC7
    andi TEMP3, 0xFC


    ; Combinar
    or TEMP3, TEMP2

    ; Sacar al puerto
    out PORTC, TEMP3

    ret


;============================================================
; CONFIGURAR TIMER1
;============================================================

CONFIG_TIMER:

    ;--------------------------------------------------------
    ; Timer1 en modo CTC
    ;--------------------------------------------------------

    ldi TEMP, (1<<WGM12)
    sts TCCR1B, TEMP


    ;--------------------------------------------------------
    ; Poner contador en 0
    ;--------------------------------------------------------

    clr TEMP

    sts TCNT1H, TEMP
    sts TCNT1L, TEMP


    ;--------------------------------------------------------
    ; OCR1A = 249
    ;
    ; 16 MHz / 64 / (249+1)
    ;
    ; = 1000 Hz
    ;
    ; Una comparación cada:
    ;
    ; 1 / 1000 = 1 ms
    ;--------------------------------------------------------

    ldi TEMP, HIGH(249)
    sts OCR1AH, TEMP

    ldi TEMP, LOW(249)
    sts OCR1AL, TEMP


    ;--------------------------------------------------------
    ; Limpiar flag OCF1A
    ;--------------------------------------------------------

    ldi TEMP, (1<<OCF1A)
    sts TIFR1, TEMP


    ;--------------------------------------------------------
    ; CTC + prescaler 64
    ;
    ; WGM12 = 1
    ; CS11  = 1
    ; CS10  = 1
    ;--------------------------------------------------------

    ldi TEMP, (1<<WGM12) | (1<<CS11) | (1<<CS10)

    sts TCCR1B, TEMP

    ret


;============================================================
; ESPERAR TIMER
;============================================================

ESPERAR_TIMER:

ESPERAR_COMPARACION:

    ; Leer registro de flags
    lds TEMP2, TIFR1


    ; ¿OCF1A = 1?
    sbrs TEMP2, OCF1A

    ; Si no, seguir esperando
    rjmp ESPERAR_COMPARACION


    ;--------------------------------------------------------
    ; Limpiar OCF1A
    ;
    ; En AVR los flags del timer se limpian escribiendo 1.
    ;--------------------------------------------------------

    ldi TEMP2, (1<<OCF1A)

    sts TIFR1, TEMP2

    ret


;============================================================
; CONFIGURAR USART
;============================================================

CONFIG_USART:

    ;--------------------------------------------------------
    ; 9600 baudios
    ; F_CPU = 16 MHz
    ;
    ; UBRR = 103
    ;--------------------------------------------------------

    ldi TEMP, 0
    sts UBRR0H, TEMP

    ldi TEMP, 103
    sts UBRR0L, TEMP


    ;--------------------------------------------------------
    ; Habilitar RX y TX
    ;--------------------------------------------------------

    ldi TEMP, (1<<RXEN0) | (1<<TXEN0)

    sts UCSR0B, TEMP


    ;--------------------------------------------------------
    ; 8 bits
    ; 1 stop
    ; Sin paridad
    ;--------------------------------------------------------

    ldi TEMP, (1<<UCSZ01) | (1<<UCSZ00)

    sts UCSR0C, TEMP

    ret


;============================================================
; RECIBIR CARACTER
;
; Espera hasta recibir algo por USART.
;
; Resultado:
; TEMP = carácter recibido
;============================================================

RECIBIR:

ESPERAR_RX:

    lds TEMP2, UCSR0A


    ; ¿RXC0 = 1?
    sbrs TEMP2, RXC0

    ; No hay dato
    rjmp ESPERAR_RX


    ; Leer carácter
    lds TEMP, UDR0

    ret


;============================================================
; REVISAR USART
;
; Esta rutina NO espera.
;
; Si no llegó nada:
;     simplemente vuelve.
;
; Si llegó '1':
;     SENAL = 1
;
; Si llegó '2':
;     SENAL = 2
;============================================================

REVISAR_USART:

    ; Leer estado USART
    lds TEMP2, UCSR0A

    sbrs TEMP2, RXC0

    ; No hay dato
    ret


    ;--------------------------------------------------------
    ; Leer carácter
    ;--------------------------------------------------------

    lds TEMP, UDR0

    cpi TEMP, '1'
    breq CAMBIAR_14

    cpi TEMP, '2'
    breq CAMBIAR_8


    ; Otro carácter: ignorar
    ret


;============================================================
; CAMBIAR A SEÑAL 14
;============================================================

CAMBIAR_14:

    ldi SENAL, 1

    clr INDICE


    ; Mostrar mensaje
    ldi ZL, LOW(MENSAJE14*2)
    ldi ZH, HIGH(MENSAJE14*2)

    rcall ENVIAR_CADENA

    ret


;============================================================
; CAMBIAR A SEÑAL 8
;============================================================

CAMBIAR_8:

    ldi SENAL, 2

    clr INDICE


    ; Mostrar mensaje
    ldi ZL, LOW(MENSAJE8*2)
    ldi ZH, HIGH(MENSAJE8*2)

    rcall ENVIAR_CADENA

    ret


;============================================================
; ENVIAR UN CARACTER
;
; TEMP = carácter que se quiere transmitir
;============================================================

ENVIAR:

ESPERAR_TX:

    lds TEMP2, UCSR0A


    ;--------------------------------------------------------
    ; ¿UDRE0 = 1?
    ;
    ; Significa que el buffer de transmisión está vacío.
    ;--------------------------------------------------------

    sbrs TEMP2, UDRE0

    rjmp ESPERAR_TX


    ; Enviar carácter
    sts UDR0, TEMP

    ret


;============================================================
; ENVIAR CADENA
;
; Z -> dirección de la cadena
;
; Las cadenas terminan en 0.
;============================================================

ENVIAR_CADENA:

SIGUE_CADENA:

    ; Leer carácter desde Flash
    ; y avanzar Z
    lpm TEMP, Z+


    ;--------------------------------------------------------
    ; ¿Llegamos al final?
    ;--------------------------------------------------------

    cpi TEMP, 0

    breq FIN_CADENA


    ; Enviar carácter
    rcall ENVIAR


    rjmp SIGUE_CADENA


FIN_CADENA:

    ret


;============================================================
; MOSTRAR MENU
;============================================================

MOSTRAR_MENU:

    ldi ZL, LOW(MENU_TXT*2)
    ldi ZH, HIGH(MENU_TXT*2)

    rcall ENVIAR_CADENA

    ret


MENU_TXT:

    .db 13,10
    .db "========================",13,10
    .db " DAC R-2R 8 BITS",13,10
    .db "========================",13,10
    .db "1 - Senal 14",13,10
    .db "2 - Senal 8",13,10
    .db "Seleccione: ",0


MENSAJE14:

    .db 13,10
    .db "Mostrando Senal 14",13,10,0


MENSAJE8:

    .db 13,10
    .db "Mostrando Senal 8",13,10,0


;============================================================
; LUT SEÑAL 14
;
; 150 muestras
;============================================================

LUT14:

